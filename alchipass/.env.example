# AlchiPass — Variables d'environnement
# Copiez ce fichier en .env.local et adaptez les valeurs.

# ── Serveur ────────────────────────────────────────────────────────
# Port d'écoute du backend Express.
# Doit correspondre à URL_BASE dans le script Python du Raspberry Pi.
# Le script Pi utilise http://127.0.0.1:3000/api → garder PORT=3000 sur le Pi.
PORT=3000

# ── Développement (Vite) ───────────────────────────────────────────
# Cible du proxy Vite pour les requêtes /api et /socket.io.
# Laissez vide pour pointer vers localhost:3000 (serveur local).
# Mettez l'IP du Pi pour développer en remote contre le Raspberry Pi.
VITE_API_TARGET=http://10.115.166.244:3000
